              {
                "text": "昨日は暑くなかったです。",
                "reading": "きのうはあつくなかったです。",
                "zh": "昨天不熱。"
              },
              {
                "text": "昨日は暑くなかった。",
                "reading": "きのうはあつくなかった。",
                "zh": "昨天不熱。"
              }
            ]
          ]
        },
