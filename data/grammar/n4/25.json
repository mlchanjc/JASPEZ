              }
            ],
            [
              {
                "text": "形容詞",
                "header": true
              },
              {
                "text": "形容詞連體形＋ようだ"
              }
            ],
            [
              {
                "text": "形容動詞",
                "header": true
              },
              {
                "text": "形容動詞連體形＋ようだ"
              }
            ],
            [
              {
                "text": "名詞",
